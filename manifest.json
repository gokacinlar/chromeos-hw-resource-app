{
    "name": "Hardware Info & Monitor Utility for ChromeOS",
    "author": "Derviş Öksüzoğlu",
    "version": "1.0.5",
    "manifest_version": 3,
    "incognito": "not_allowed",
    "description": "Simple & Powerful Hardware Information Utility for ChromeOS.",
    "icons": {
        "16": "icons/icon_16x16.png",
        "32": "icons/icon_32x32.png",
        "48": "icons/icon_48x48.png",
        "128": "icons/icon_128x128.png"
    },
    "background": {
        "service_worker": "/src/background/service_worker.js"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "/src/app.js"
            ]
        }
    ],
    "permissions": [
        "system.cpu",
        "system.memory",
        "system.storage",
        "system.display",
        "storage"
    ],
    "action": {
        "default_popup": "popup/popup.html",
        "default_title": "ChromeOS Resource Monitor",
        "default_icon": {
            "16": "icons/icon_16x16.png",
            "48": "icons/icon_48x48.png"
        }
    },
    "options_page": "options.html",
    "default_locale": "en",
    "web_accessible_resources": [
        {
            "resources": [
                "/images/logo.png"
            ],
            "matches": [
                "<all_urls>"
            ]
        }
    ]
}